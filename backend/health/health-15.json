{
  "host_label": ".15",
  "state_file": "/var/lib/domopi-health/state.json",
  "checks": ["power", "services", "broker", "http", "reachability", "energy_data", "emontx_sign",
             "mosquitto_config", "internet", "resources", "kernel_errors", "clock", "backups", "powerwall_charge"],
  "services": ["mosquitto", "nodered", "emonhub", "emoncms_mqtt", "feedwriter", "redis-server", "mariadb",
               "apache2"],
  "urgent_services": ["mosquitto", "nodered", "emonhub"],
  "broker": {"client": "paho", "host": "127.0.0.1", "port": 1883, "user": "emonpi",
             "password_file": "/etc/domopi-health/mqtt_local.pass"},
  "mosquitto": {"files": ["/etc/mosquitto/mosquitto.conf", "/etc/mosquitto/conf.d/*.conf"],
                "expect": {"persistence": "true", "anonymous:default": "false"}},
  "http": [{"name": "nodered", "title": "Node-RED", "url": "http://127.0.0.1:1880/"},
           {"name": "emoncms", "title": "EmonCMS", "url": "http://127.0.0.1/emoncms/"}],
  "emoncms_feeds": [{"name": "Powerwall", "feed": 305, "max_age_s": 600},
                    {"name": "emonTx", "feed": 24, "max_age_s": 600}],
  "emontx_sign": {"site_feed": 305, "import_feed": 24, "export_feed": 27, "min_w": 150, "mismatches": 10},
  "backups": {"rasp": [{"mode": "snapshot", "max_age_h": 26}, {"mode": "image", "max_age_h": 192}],
              "emoncms": {"status_file": "/media/nas-backup/emoncms/status.json", "mount": "/media/nas-backup",
                          "max_age_h": 26}},
  "powerwall_charge": {"soc_feed": 304, "battery_feed": 306, "grid_feed": 305, "target_feed": 461,
                       "discharge_w": 200, "export_w": 500, "soc_max": 95, "readings": 10, "clear_readings": 15},
  "peer": {"name": ".20", "ip": "192.168.1.20", "port": 1883},
  "router": "192.168.1.1",
  "internet": ["1.1.1.1", "8.8.8.8"],
  "confirm": {"peer": 3, "router": 3, "internet": 3, "http": 2, "broker": 2, "energy": 2},
  "quiet_hours": [23, 7],
  "publish": {"client": "paho", "host": "192.168.1.20", "port": 1883, "user": "domotica",
              "password_file": "/etc/domopi-health/mqtt.pass", "topic": "zara/system/health/15/stat"},
  "ntfy": {"host": "domopi.tailf30ba8.ts.net:8443", "connect_ip": "192.168.1.20", "topic": "domopi-casa",
           "token_file": "/etc/domopi-health/ntfy.token"}
}
