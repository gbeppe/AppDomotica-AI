[Unit]
Description=DomoPi nightly backup snapshot to the QNAP (phase S4)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/domopi-backup/rasp_backup.sh snapshot
Nice=19
IOSchedulingClass=idle
# first to go if memory runs out (the memory cgroup is off in these kernels: no MemoryMax=)
OOMScoreAdjust=500
# stop: SIGTERM to the script only, which stops rsync and cleans up (mounts, loop devices)
KillMode=mixed
TimeoutStopSec=120
TimeoutStartSec=4h
