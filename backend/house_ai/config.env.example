# Example only: configure real values in a private environment, never commit secrets.
EMONCMS_URL=https://YOUR_EMONCMS_BASE
EMONCMS_API_KEY=REPLACE_WITH_READ_ONLY_KEY
HOUSE_AI_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS
HOUSE_AI_BIND=127.0.0.1
HOUSE_AI_PORT=8765
# Set only when this directory (or a local copy) is accessible to the backend process.
HOUSE_AI_LOG_ROOT=/home/pi/AI_climate
HOUSE_AI_CLIMATE_LOG=/home/pi/AI_climate/clima_controllo.log
# Provider-neutral gateway implementing house_ai.planner_request.v1; not a provider API URL.
HOUSE_AI_PLANNER_URL=https://YOUR_GATEWAY/v1/plan
HOUSE_AI_PLANNER_TOKEN=REPLACE_WITH_GATEWAY_TOKEN
