# Copy to /etc/house-ai/backend.env, owner root:house-ai, mode 0640.
EMONCMS_URL=http://192.168.1.15/emoncms
EMONCMS_API_KEY=REPLACE_WITH_READ_ONLY_EMONCMS_KEY
HOUSE_AI_TOKEN=REPLACE_WITH_A_RANDOM_ANDROID_TOKEN_AT_LEAST_24_CHARACTERS
HOUSE_AI_BIND=127.0.0.1
HOUSE_AI_PORT=8765
HOUSE_AI_LOG_ROOT=/home/pi/AI_climate
HOUSE_AI_CLIMATE_LOG=/home/pi/AI_climate/clima_controllo.log
HOUSE_AI_PLANNER_URL=http://127.0.0.1:8766/v1/plan
HOUSE_AI_PLANNER_TOKEN=REPLACE_WITH_THE_SAME_SHARED_TOKEN_AS_GATEWAY
