# Copy to /etc/house-ai/lan.env, owner root:house-ai, mode 0640. No secrets here.
HOUSE_AI_LAN_BIND=192.168.1.20
HOUSE_AI_LAN_PORT=443
HOUSE_AI_LAN_ALLOW=192.168.1.0/24
HOUSE_AI_LAN_UPSTREAM=http://127.0.0.1:8765
HOUSE_AI_LAN_CERT=/etc/house-ai/tls/cert.pem
HOUSE_AI_LAN_KEY=/etc/house-ai/tls/key.pem
